# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (optional — only needed when using engine=claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis — local: redis://localhost:6379 | Upstash: rediss://...
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins for production, e.g. https://app.example.com,https://admin.example.com
# Leave as "*" for local dev only (credentials are auto-disabled with "*").
CORS_ORIGINS=*

# Auth — set to require a key on /api/analyze and /api/jobs routes.
# HTTP: "Authorization: Bearer <key>"  |  WebSocket: "?token=<key>"
# Leave unset to disable auth (dev only).
# API_KEY=change-me-to-a-long-random-string

# Set true ONLY when running behind a proxy/LB you control, so rate limiting
# reads the client IP from X-Forwarded-For instead of the proxy's IP.
TRUST_PROXY=false

# AI settings (optional — defaults shown)
AI_ENGINE=gemini
GEMINI_MODEL=gemini-2.5-flash
ANALYSIS_SAMPLES=3
AI_MAX_CONCURRENT=10

# Storage (optional — defaults shown)
IMAGE_DIR=images

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (optional — only needed when using engine=claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis — local: redis://localhost:6379 | Upstash: rediss://...
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins for production, e.g. https://app.example.com,https://admin.example.com
# Leave as "*" for local dev only (credentials are auto-disabled with "*").
CORS_ORIGINS=*

# Auth — every key issued via `python scripts/manage_api_keys.py create <name>`
# may call /api/analyze and /api/jobs routes.
# HTTP: "Authorization: Bearer <key>"  |  WebSocket: "?token=<key>"
# No keys on disk (API_KEY_DIR empty) = auth disabled (dev only).
API_KEY_DIR=api_keys
DEFAULT_DAILY_AI_CALL_LIMIT=1000   # used by keys that don't set their own daily_limit

# Set true ONLY when running behind a proxy/LB you control, so rate limiting
# reads the client IP from X-Forwarded-For instead of the proxy's IP.
TRUST_PROXY=false

# AI settings (optional — defaults shown)
AI_ENGINE=gemini
GEMINI_MODEL=gemini-2.5-flash
ANALYSIS_SAMPLES=3            # self-consistency samples per image (1 = disabled)
MAX_ANALYSIS_SAMPLES=5       # upper bound a caller may request via the `samples` field
AI_MAX_CONCURRENT=10         # hard cap on concurrent AI API calls
AI_CALL_TIMEOUT=120          # seconds before a single AI call is aborted + retried

# Job limits & reliability (optional — defaults shown)
MAX_JOB_API_CALLS=1000           # reject a job whose images × samples exceeds this
SUBMIT_RATE_LIMIT=10             # max job submissions per IP per minute
WS_HEARTBEAT_INTERVAL=30         # WebSocket heartbeat / state re-check interval (s)
STUCK_JOB_TIMEOUT=600            # idle seconds before a job is reaped as failed
STUCK_JOB_REAPER_INTERVAL=60     # how often the stuck-job reaper scans (s)

# Storage (optional — defaults shown)
IMAGE_DIR=images
MAX_IMAGE_BYTES=20971520         # per-image size limit (20 MB)
MAX_JOB_TOTAL_BYTES=1073741824   # combined size limit across one job's images (1 GB)

# Prompt library (optional — defaults shown)
PROMPT_DIR=prompt_store          # durable on-disk store for custom prompts (not Redis)
MAX_PROMPT_CHARS=20000           # max length of a stored prompt's text
